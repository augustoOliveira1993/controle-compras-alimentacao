{
  "name": "controle-compras",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "jest --runInBand && pnpm --filter @compras/web exec jest --config jest.config.cjs --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config apps/api/test/jest.integration.cjs --runInBand",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "jest": "^30",
    "@playwright/test": "^1",
    "@types/node": "^24"
  }
}

